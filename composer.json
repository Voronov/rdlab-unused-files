{
    "name": "rdlab/unused-files",
    "type": "typo3-cms-extension",
    "description": "Lists FAL files that are not referenced anywhere in TYPO3 and lets you delete them: CSV report via CLI and a backend module under File.",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "FAL",
        "cleanup",
        "unused files"
    ],
    "authors": [
        {
            "name": "RDLAB",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^13.4",
        "typo3/cms-core": "^13.4",
        "typo3/cms-filelist": "^13.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "typo3/testing-framework": "^9.2",
        "phpstan/phpstan": "^2.1",
        "typo3/coding-standards": "^0.8"
    },
    "autoload": {
        "psr-4": {
            "RDLAB\\UnusedFiles\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RDLAB\\UnusedFiles\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "rdlab_unused_files",
            "web-dir": ".Build/Web"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "scripts": {
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "test:cgl": "php-cs-fixer fix --dry-run --diff",
        "test:phpstan": "phpstan analyse -c Build/phpstan/phpstan.neon --no-progress",
        "fix:cgl": "php-cs-fixer fix"
    }
}
