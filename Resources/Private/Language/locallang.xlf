<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" datatype="plaintext" original="EXT:rdlab_unused_files/Resources/Private/Language/locallang.xlf" date="2026-10-29T12:00:00Z" product-name="rdlab_unused_files">
        <header/>
        <body>
            <trans-unit id="module.title" resname="module.title">
                <source>Unused files</source>
            </trans-unit>
            <trans-unit id="module.intro" resname="module.intro">
                <source>Files listed here have no reference in TYPO3: no file relation (images, media, attachments), no RTE or link field pointing to them. References from outside TYPO3 (newsletters, direct links, other websites) and folder based usage (file collections of type "folder", TypoScript FILES with folders, plugins reading a folder) are not known to TYPO3, so review the list before deleting.</source>
            </trans-unit>
            <trans-unit id="referenceIndex.updated" resname="referenceIndex.updated">
                <source>Reference index last updated: %s</source>
            </trans-unit>
            <trans-unit id="referenceIndex.never" resname="referenceIndex.never">
                <source>The reference index has never been updated. The list is not reliable until "typo3 referenceindex:update" has been run.</source>
            </trans-unit>
            <trans-unit id="referenceIndex.stale" resname="referenceIndex.stale">
                <source>The reference index was last updated on %s, which is older than %d hours. Run "typo3 referenceindex:update" before deleting files.</source>
            </trans-unit>
            <trans-unit id="filter.title" resname="filter.title">
                <source>Filter</source>
            </trans-unit>
            <trans-unit id="filter.storage" resname="filter.storage">
                <source>Storage</source>
            </trans-unit>
            <trans-unit id="filter.storage.all" resname="filter.storage.all">
                <source>All storages</source>
            </trans-unit>
            <trans-unit id="filter.folder" resname="filter.folder">
                <source>Folder</source>
            </trans-unit>
            <trans-unit id="filter.folder.all" resname="filter.folder.all">
                <source>All storages (select a folder in the tree to narrow the list)</source>
            </trans-unit>
            <trans-unit id="summary.scope" resname="summary.scope">
                <source>Folder %s including subfolders.</source>
            </trans-unit>
            <trans-unit id="summary.scope.all" resname="summary.scope.all">
                <source>All storages, select a folder in the tree to narrow the list.</source>
            </trans-unit>
            <trans-unit id="filter.extension" resname="filter.extension">
                <source>File type</source>
            </trans-unit>
            <trans-unit id="filter.extension.all" resname="filter.extension.all">
                <source>All types</source>
            </trans-unit>
            <trans-unit id="filter.minAgeDays" resname="filter.minAgeDays">
                <source>Older than (days)</source>
            </trans-unit>
            <trans-unit id="filter.search" resname="filter.search">
                <source>File name contains</source>
            </trans-unit>
            <trans-unit id="filter.itemsPerPage" resname="filter.itemsPerPage">
                <source>Per page</source>
            </trans-unit>
            <trans-unit id="filter.apply" resname="filter.apply">
                <source>Apply filter</source>
            </trans-unit>
            <trans-unit id="filter.reset" resname="filter.reset">
                <source>Reset</source>
            </trans-unit>
            <trans-unit id="summary" resname="summary">
                <source>%s unused files, %s in total</source>
            </trans-unit>
            <trans-unit id="summary.excluded" resname="summary.excluded">
                <source>Excluded folders: %s</source>
            </trans-unit>
