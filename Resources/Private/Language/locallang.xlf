            </trans-unit>
            <trans-unit id="list.openFile" resname="list.openFile">
                <source>Open file in a new tab</source>
            </trans-unit>
            <trans-unit id="list.showFolder" resname="list.showFolder">
                <source>Show folder in the file list</source>
            </trans-unit>
            <trans-unit id="delete.single" resname="delete.single">
                <source>Delete file</source>
            </trans-unit>
            <trans-unit id="delete.single.confirm" resname="delete.single.confirm">
                <source>Delete the file "%s"? It is moved to the _recycler_ folder of its storage.</source>
            </trans-unit>
            <trans-unit id="delete.selected" resname="delete.selected">
                <source>Delete selected</source>
            </trans-unit>
            <trans-unit id="delete.selected.confirm" resname="delete.selected.confirm">
                <source>Delete %d selected files? Each file is checked again for references right before it is deleted.</source>
            </trans-unit>
            <trans-unit id="delete.all.confirm" resname="delete.all.confirm">
                <source>Delete all %d files matching the current filter? At most %d files are deleted per run, repeat the action for the rest. Each file is checked again for references right before it is deleted.</source>
            </trans-unit>
            <trans-unit id="selection.page" resname="selection.page">
                <source>All %d files on this page are selected.</source>
            </trans-unit>
            <trans-unit id="selection.selectAll" resname="selection.selectAll">
                <source>Select all %d files matching the filter</source>
            </trans-unit>
            <trans-unit id="selection.all" resname="selection.all">
                <source>All %d files matching the filter are selected.</source>
            </trans-unit>
            <trans-unit id="selection.clear" resname="selection.clear">
                <source>Clear selection</source>
            </trans-unit>
            <trans-unit id="delete.confirm.title" resname="delete.confirm.title">
                <source>Please confirm</source>
            </trans-unit>
            <trans-unit id="delete.confirm.ok" resname="delete.confirm.ok">
                <source>Yes, delete</source>
            </trans-unit>
            <trans-unit id="delete.confirm.cancel" resname="delete.confirm.cancel">
                <source>Cancel</source>
            </trans-unit>
            <trans-unit id="pagination.first" resname="pagination.first">
