                <source>No unused files found for the current filter.</source>
            </trans-unit>
            <trans-unit id="list.toggleAll" resname="list.toggleAll">
                <source>Select all files on this page</source>
            </trans-unit>
            <trans-unit id="list.file" resname="list.file">
                <source>File</source>
            </trans-unit>
            <trans-unit id="list.folder" resname="list.folder">
                <source>Folder</source>
            </trans-unit>
            <trans-unit id="list.type" resname="list.type">
