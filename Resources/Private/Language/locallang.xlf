            </trans-unit>
            <trans-unit id="pagination.last" resname="pagination.last">
                <source>Last page</source>
            </trans-unit>
            <trans-unit id="pagination.info" resname="pagination.info">
                <source>Page %s of %s</source>
            </trans-unit>
            <trans-unit id="button.csv" resname="button.csv">
                <source>Download CSV</source>
            </trans-unit>
            <trans-unit id="button.reload" resname="button.reload">
                <source>Reload</source>
            </trans-unit>
            <trans-unit id="message.nothingSelected" resname="message.nothingSelected">
                <source>No files were selected.</source>
            </trans-unit>
            <trans-unit id="message.deleted.title" resname="message.deleted.title">
                <source>%d files removed</source>
            </trans-unit>
            <trans-unit id="message.deleted" resname="message.deleted">
                <source>%d deleted, %d moved to the recycler folder.</source>
            </trans-unit>
            <trans-unit id="message.skipped" resname="message.skipped">
                <source>%d files were skipped because they are referenced by now or no longer exist.</source>
            </trans-unit>
            <trans-unit id="message.failed.title" resname="message.failed.title">
                <source>%d files could not be deleted</source>
            </trans-unit>
            <trans-unit id="message.remaining" resname="message.remaining">
                <source>%d more files match the filter. At most %d files are deleted per run, repeat "Delete all" for the rest.</source>
            </trans-unit>
            <trans-unit id="message.staleIndex" resname="message.staleIndex">
                <source>The reference index is older than %d hours. Run "typo3 referenceindex:update" before deleting files.</source>
            </trans-unit>
            <trans-unit id="recycled.title" resname="recycled.title">
                <source>Deleted files</source>
            </trans-unit>
            <trans-unit id="recycled.intro" resname="recycled.intro">
                <source>Files this module or its delete command moved to a recycler folder. "Restore" moves a file back to the folder it came from. A file disappears from this list once it is restored or removed from the recycler folder for good.</source>
            </trans-unit>
            <trans-unit id="recycled.empty" resname="recycled.empty">
                <source>No deleted files to restore.</source>
            </trans-unit>
            <trans-unit id="recycled.originalFolder" resname="recycled.originalFolder">
                <source>Original folder</source>
            </trans-unit>
            <trans-unit id="recycled.deletedAt" resname="recycled.deletedAt">
                <source>Deleted</source>
            </trans-unit>
            <trans-unit id="recycled.deletedBy" resname="recycled.deletedBy">
                <source>Deleted by</source>
            </trans-unit>
            <trans-unit id="recycled.restore" resname="recycled.restore">
                <source>Restore</source>
            </trans-unit>
            <trans-unit id="button.recycled" resname="button.recycled">
                <source>Deleted files (%d)</source>
            </trans-unit>
            <trans-unit id="message.restored" resname="message.restored">
                <source>%s was restored.</source>
            </trans-unit>
            <trans-unit id="message.restoreFailed.title" resname="message.restoreFailed.title">
                <source>The file could not be restored</source>
            </trans-unit>
