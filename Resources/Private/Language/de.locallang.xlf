                <target>Es wurden keine Dateien ausgewählt.</target>
            </trans-unit>
            <trans-unit id="message.deleted.title" resname="message.deleted.title">
                <source>%d files removed</source>
                <target>%d Dateien entfernt</target>
            </trans-unit>
            <trans-unit id="message.deleted" resname="message.deleted">
                <source>%d deleted, %d moved to the recycler folder.</source>
                <target>%d gelöscht, %d in den Ordner _recycler_ verschoben.</target>
            </trans-unit>
            <trans-unit id="message.skipped" resname="message.skipped">
                <source>%d files were skipped because they are referenced by now or no longer exist.</source>
                <target>%d Dateien wurden übersprungen, weil sie inzwischen referenziert werden oder nicht mehr existieren.</target>
            </trans-unit>
            <trans-unit id="message.failed.title" resname="message.failed.title">
                <source>%d files could not be deleted</source>
                <target>%d Dateien konnten nicht gelöscht werden</target>
            </trans-unit>
            <trans-unit id="message.remaining" resname="message.remaining">
                <source>%d more files match the filter. At most %d files are deleted per run, repeat "Delete all" for the rest.</source>
                <target>%d weitere Dateien entsprechen dem Filter. Pro Durchlauf werden höchstens %d Dateien gelöscht, wiederholen Sie „Alle löschen“ für den Rest.</target>
            </trans-unit>
            <trans-unit id="message.staleIndex" resname="message.staleIndex">
                <source>The reference index is older than %d hours. Run "typo3 referenceindex:update" before deleting all matching files.</source>
                <target>Der Referenzindex ist älter als %d Stunden. Führen Sie „typo3 referenceindex:update“ aus, bevor Sie alle passenden Dateien löschen.</target>
