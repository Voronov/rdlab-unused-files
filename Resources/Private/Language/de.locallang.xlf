                <target>Ordner</target>
            </trans-unit>
            <trans-unit id="filter.folder.all" resname="filter.folder.all">
                <source>All storages (select a folder in the tree to narrow the list)</source>
                <target>Alle Speicher (wählen Sie im Baum einen Ordner, um die Liste einzuschränken)</target>
            </trans-unit>
            <trans-unit id="summary.scope" resname="summary.scope">
                <source>Folder %s including subfolders.</source>
                <target>Ordner %s einschließlich Unterordner.</target>
            </trans-unit>
            <trans-unit id="summary.scope.all" resname="summary.scope.all">
                <source>All storages, select a folder in the tree to narrow the list.</source>
                <target>Alle Speicher. Wählen Sie im Baum einen Ordner, um die Liste einzuschränken.</target>
            </trans-unit>
            <trans-unit id="filter.extension" resname="filter.extension">
                <source>File type</source>
                <target>Dateityp</target>
            </trans-unit>
            <trans-unit id="filter.extension.all" resname="filter.extension.all">
                <source>All types</source>
                <target>Alle Typen</target>
            </trans-unit>
            <trans-unit id="filter.minAgeDays" resname="filter.minAgeDays">
                <source>Older than (days)</source>
                <target>Älter als (Tage)</target>
            </trans-unit>
            <trans-unit id="filter.search" resname="filter.search">
